      "--dur-fade",
      "--dur-fly",
      "--dur-hover",
      "--dur-loader",
      "--dur-micro",
      "--dur-pop",
      "--dur-slide",
      "--dur-ui",
      "--ease",
      "--ease-fly",
      "--ease-in-out",
      "--ease-out",
      "--font-display",
      "--font-sans",
      "--grey-1",
      "--grey-2",
      "--grey-4",
      "--ink",
      "--ink-40",
      "--ink-55",
      "--ink-70",
      "--lavender",
      "--lift",
      "--limestone",
      "--radius-2xl",
      "--radius-card",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--radius-xl",
      "--radius-xs",
      "--shadow-lg",
